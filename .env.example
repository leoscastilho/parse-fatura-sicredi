# ---------------------------------------------------------------------------
#  Copie para `.env` e preencha. NUNCA versione o `.env`.
# ---------------------------------------------------------------------------

# Porta em que o site fica na VM do Proxmox.
FATURA_HTTP_PORT=8080

# --- GitHub -----------------------------------------------------------------
# Fine-grained PAT: github.com/settings/personal-access-tokens
#   Repository access : Only select repositories -> parser-de-fatura-multibancos
#   Permissions       : Contents = Read and write   (só isso)
#   Expiration        : 90 dias, e renove
#
# NÃO use classic token com escopo `repo`: ele dá acesso a TODOS os seus
# repositórios privados, e este container só precisa mexer num arquivo.
#
# Deixe vazio para rodar sem GitHub — tudo funciona, o YAML só não é publicado.
FATURA_GITHUB_TOKEN=
FATURA_GITHUB_REPO=leoscastilho/parser-de-fatura-multibancos
FATURA_GITHUB_BRANCH=main
